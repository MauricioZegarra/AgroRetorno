@startuml
!theme plain
skinparam backgroundColor #FCFDFB
skinparam shadowing false
skinparam dpi 160
skinparam roundcorner 13
skinparam SequenceMessageAlign center
skinparam sequence {
  ArrowColor #286B55
  LifeLineBorderColor #81A999
  LifeLineBackgroundColor #F3F9F5
  ParticipantBorderColor #397B66
  ParticipantBackgroundColor #E5F3EA
  ActorBorderColor #397B66
  ActorBackgroundColor #E5F3EA
  GroupBorderColor #8ABDA1
  GroupBackgroundColor #F3F9F5
  GroupHeaderFontColor #205A45
}
skinparam note {
  BorderColor #BE9A55
  BackgroundColor #FFF9E9
}
title G03 · Secuencia 02 — Aprobar solicitud (RF09)
actor "Encargado" as E
boundary "EncargadoSolicitudController" as EC
control "SolicitudService" as SS
control "UsuarioService" as US
entity "SolicitudRepository" as SRepo
control "InventarioService" as IS
control "HistorialService" as HS

E -> EC: POST /encargado/solicitudes/{id}/aprobar
activate EC
note over EC: Solo usuarios con rol ENCARGADO
EC -> SS: aprobar(id, usernameEncargado)
activate SS
SS -> US: obtenerPorUsername(usernameEncargado)
US --> SS: Usuario encargado
SS -> SRepo: findByIdParaActualizar(id)
note right of SRepo: @Lock(PESSIMISTIC_WRITE)
sobre Solicitud
SRepo --> SS: Solicitud
alt Estado distinto de PENDIENTE
    SS --> EC: ReglaNegocioException
    EC --> E: redirect al detalle + error
else Estado PENDIENTE
    SS -> IS: validarDisponibilidad(material, cantidad)
    IS --> SS: Válido o excepción
    alt Stock suficiente y material activo
        SS -> SS: setEstado(APROBADA)
setRespondidoPor(encargado)
setFechaRespuesta(ahora)
        SS -> HS: registrar(APROBAR_SOLICITUD)
        HS --> SS: Operación registrada
        SS --> EC: SolicitudResponse(APROBADA)
        EC --> E: redirect al detalle + confirmación
    else Stock insuficiente o material inactivo
        SS --> EC: ReglaNegocioException
        EC --> E: redirect al detalle + error
    end
end
deactivate SS
deactivate EC
note bottom
APROBAR no descuenta inventario ni crea préstamo.
El descuento se realiza al registrar la entrega física.
end note
@enduml
