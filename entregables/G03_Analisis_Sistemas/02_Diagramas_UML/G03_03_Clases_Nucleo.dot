digraph agroretorno {
	graph [bgcolor="#ffffff" compound=true fontcolor="#1e3d4f" fontname=Arial fontsize=22 label="G03 | Modelo de clases — núcleo del préstamo y devolución" labelloc=t nodesep=0.65 overlap=false pad=0.38 rankdir=LR ranksep=1.05 splines=spline]
	node [fontname=Arial shape=plain]
	edge [arrowsize=0.65 color="#557486" fontcolor="#324a59" fontname=Arial fontsize=11 penwidth=1.5]
	Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#dcecf5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#234a6b"><B>Usuario</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− username: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− nombreCompleto: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− rol: Rol</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− activo: boolean</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ getRol(): Rol</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ isActivo(): boolean</FONT></TD></TR></TABLE>>]
	Productor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#dcecf5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#234a6b"><B>Productor</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− dni: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− nombres: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− apellidos: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− sector: String</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ getNombreCompleto(): String</FONT></TD></TR></TABLE>>]
	Material [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#daf2e5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#1f5945"><B>Material</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− codigo: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− nombre: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− categoria: CategoriaMaterial</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− estado: EstadoMaterial</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ isActivo(): boolean</FONT></TD></TR></TABLE>>]
	Inventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#daf2e5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#1f5945"><B>Inventario</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidadTotal: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidadDisponible: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidadPrestada: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidadDanada: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidadMantenimiento: int</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ estaCuadrado(): boolean</FONT></TD></TR></TABLE>>]
	Solicitud [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#e7e3fb" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#4c3974"><B>Solicitud</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidad: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− fechaDevolucionPrevista: LocalDate</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− estado: EstadoSolicitud</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− motivo: String</FONT></TD></TR></TABLE>>]
	Prestamo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#e7e3fb" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#4c3974"><B>Prestamo</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidadEntregada: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidadDevuelta: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− estado: EstadoPrestamo</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− fechaCierre: LocalDateTime</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ getCantidadPendiente(): int</FONT></TD></TR></TABLE>>]
	Devolucion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#fff0d8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#69431e"><B>Devolucion</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− fecha: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− observaciones: String</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ agregarDetalle(...): void</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ getCantidadTotal(): int</FONT></TD></TR></TABLE>>]
	DetalleDevolucion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#fff0d8" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#69431e"><B>DetalleDevolucion</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− estadoMaterial: CondicionDevolucion</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidad: int</FONT></TD></TR></TABLE>>]
	Usuario -> Productor [label="cuenta de productor" arrowtail=none color="#647f91" dir=none headlabel="0..1" penwidth=1.4 taillabel=1]
	Productor -> Solicitud [label=realiza arrowtail=none color="#647f91" dir=none headlabel="0..*" penwidth=1.4 taillabel=1]
	Material -> Solicitud [label="es solicitado" arrowtail=none color="#647f91" dir=none headlabel="0..*" penwidth=1.4 taillabel=1]
	Material -> Inventario [label=controla arrowtail=none color="#647f91" dir=none headlabel="0..1" penwidth=1.4 taillabel=1]
	Solicitud -> Prestamo [label=origina arrowtail=none color="#647f91" dir=none headlabel="0..1" penwidth=1.4 taillabel=1]
	Prestamo -> Devolucion [label=registra arrowtail=none color="#647f91" dir=none headlabel="0..*" penwidth=1.4 taillabel=1]
	Devolucion -> DetalleDevolucion [label=contiene arrowtail=diamond color="#c18b47" dir=back headlabel="0..*" penwidth=1.6 taillabel=1]
}
