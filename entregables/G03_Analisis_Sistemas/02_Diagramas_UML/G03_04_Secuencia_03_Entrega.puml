@startuml
!theme plain
skinparam backgroundColor #FCFDFB
skinparam shadowing false
skinparam dpi 160
skinparam roundcorner 13
skinparam SequenceMessageAlign center
skinparam sequence {
  ArrowColor #286B55
  LifeLineBorderColor #81A999
  LifeLineBackgroundColor #F3F9F5
  ParticipantBorderColor #397B66
  ParticipantBackgroundColor #E5F3EA
  ActorBorderColor #397B66
  ActorBackgroundColor #E5F3EA
  GroupBorderColor #8ABDA1
  GroupBackgroundColor #F3F9F5
  GroupHeaderFontColor #205A45
}
skinparam note {
  BorderColor #BE9A55
  BackgroundColor #FFF9E9
}
title G03 · Secuencia 03 — Registrar entrega (RF11)
actor "Encargado" as E
boundary "EncargadoSolicitudController" as EC
control "PrestamoService" as PS
entity "SolicitudRepository" as SRepo
entity "PrestamoRepository" as PRepo
control "InventarioService" as IS
entity "InventarioRepository" as IRepo
control "HistorialService" as HS

E -> EC: POST /encargado/solicitudes/{id}/entregar
activate EC
EC -> PS: registrarEntrega(id, usernameEncargado)
activate PS
note over PS: Obtiene el encargado mediante UsuarioService
(omitido en la vista por legibilidad)
PS -> SRepo: findByIdParaActualizar(id)
SRepo --> PS: Solicitud bloqueada
PS -> PRepo: existsBySolicitudId(id)
PRepo --> PS: boolean
alt Ya entregada, préstamo existente o no APROBADA
    PS --> EC: ReglaNegocioException
    EC --> E: redirect al detalle + error
else Solicitud APROBADA y material activo
    PS -> IS: descontarPorEntrega(materialId, cantidad, actor, referencia)
    activate IS
    IS -> IRepo: findByMaterialIdParaActualizar(materialId)
    IRepo --> IS: Inventario bloqueado
    alt Disponibilidad insuficiente
        IS --> PS: ReglaNegocioException
        PS --> EC: Excepción / transacción sin cambios
        EC --> E: redirect al detalle + error
    else Disponibilidad suficiente
        IS -> IS: disponible -= cantidad
prestada += cantidad
verificar cuadre
        IS -> IRepo: save(inventario)
        note over IS: También registra movimiento
TipoMovimiento.ENTREGA
        IS --> PS: Inventario actualizado
        PS -> PRepo: save(new Prestamo(...))
        PRepo --> PS: Prestamo con id
        PS -> PS: solicitud.setEstado(ENTREGADA)
solicitud.setPrestamo(prestamo)
        PS -> HS: registrar(REGISTRAR_ENTREGA)
        HS --> PS: Operación registrada
        PS --> EC: PrestamoResponse(ACTIVO)
        EC --> E: redirect al detalle + confirmación
    end
    deactivate IS
end
deactivate PS
deactivate EC
note bottom
@Transactional en PrestamoService e InventarioService.
La entrega descontará unidades disponibles y aumentará las prestadas.
El stock se vuelve a validar con bloqueo de fila.
end note
@enduml
