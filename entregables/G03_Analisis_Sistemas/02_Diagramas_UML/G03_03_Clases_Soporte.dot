digraph agroretorno {
	graph [bgcolor="#ffffff" compound=true fontcolor="#1e3d4f" fontname=Arial fontsize=22 label="G03 | Entidades de soporte — movimientos y auditoría" labelloc=t nodesep=0.65 overlap=false pad=0.38 rankdir=LR ranksep=1.05 splines=spline]
	node [fontname=Arial shape=plain]
	edge [arrowsize=0.65 color="#557486" fontcolor="#324a59" fontname=Arial fontsize=11 penwidth=1.5]
	Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#dcecf5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#234a6b"><B>Usuario</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− username: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− nombreCompleto: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− rol: Rol</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− activo: boolean</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ getRol(): Rol</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ isActivo(): boolean</FONT></TD></TR></TABLE>>]
	Material [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#daf2e5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#1f5945"><B>Material</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− codigo: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− nombre: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− categoria: CategoriaMaterial</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− estado: EstadoMaterial</FONT></TD></TR><TR><TD HEIGHT="1" BGCOLOR="#d7e0e7"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">+ isActivo(): boolean</FONT></TD></TR></TABLE>>]
	MovimientoInventario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#eef1f5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#38485a"><B>MovimientoInventario</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− tipo: TipoMovimiento</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− cantidad: int</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− fecha: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− referencia: String</FONT></TD></TR></TABLE>>]
	HistorialOperacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0" COLOR="#b4c4cf" BGCOLOR="white"><TR><TD BGCOLOR="#eef1f5" CELLPADDING="10" ALIGN="CENTER"><FONT FACE="Arial" POINT-SIZE="15" COLOR="#38485a"><B>HistorialOperacion</B></FONT></TD></TR><TR><TD HEIGHT="2" BGCOLOR="#b4c4cf"></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− id: Long</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− fechaHora: LocalDateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− actor: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− accion: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− entidad: String</FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#233446">− entidadId: Long</FONT></TD></TR></TABLE>>]
	Material -> MovimientoInventario [label=material dir=none headlabel="0..*" taillabel=1]
	Usuario -> MovimientoInventario [label="registrado por" dir=none headlabel="0..*" taillabel=1]
	HistorialOperacion -> MovimientoInventario [label="sin FK directa" dir=none style=invis]
	Nota [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" BGCOLOR="#f9fafb" COLOR="#dae0e5"><TR><TD CELLPADDING="10"><FONT FACE="Arial" POINT-SIZE="11" COLOR="#495869">HistorialOperacion registra actor, entidad y entidadId como valores.<BR/>No posee asociación JPA directa con otras entidades.</FONT></TD></TR></TABLE>>]
	HistorialOperacion -> Nota [arrowhead=none color="#9baeba" style=dotted]
}
