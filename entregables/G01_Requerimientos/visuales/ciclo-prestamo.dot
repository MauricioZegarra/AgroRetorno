digraph G01 {
  graph [bgcolor="#F1F6F3", rankdir=TB, pad=0.28, nodesep=0.26, ranksep=0.44, dpi=150, splines=ortho];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11,
        margin="0.20,0.14", color="#A8C3B3", fontcolor="#133127", fillcolor="#FFFFFF"];
  edge [color="#568071", penwidth=1.2, arrowsize=0.68];
  title [shape=plaintext, fontsize=17, label="Ciclo de préstamo e inventario"];
  productor [label="PRODUCTOR\nCrea y consulta sus solicitudes", fillcolor="#DCECE5"];
  encargado [label="ENCARGADO\nResuelve, entrega y registra devoluciones", fillcolor="#DCECE5"];
  solicitud [label="PENDIENTE\nRF07 · Valida cantidad, fecha y motivo"];
  aprobada [label="APROBADA\nRF09 · Valida stock sin reservarlo"];
  rechazada [label="RECHAZADA\nRF10 · Motivo visible", fillcolor="#FAEDDC", color="#D8B289"];
  obra [label="ENTREGADA · PRÉSTAMO ACTIVO\nRF11 · Revalida y mueve unidades"];
  parcial [label="DEVOLUCIÓN PARCIAL\nRF13 · Clasifica unidades y conserva saldo"];
  cierre [label="PRÉSTAMO CERRADO\nRF13 · Saldo pendiente igual a cero", fillcolor="#DCECE5"];
  title -> productor [style=invis]; title -> encargado [style=invis];
  { rank=same; productor; encargado; }
  { rank=same; aprobada; rechazada; }
  productor -> solicitud;
  encargado -> aprobada [style=dashed];
  solicitud -> aprobada; solicitud -> rechazada;
  aprobada -> obra;
  obra -> parcial; obra -> cierre;
  parcial -> cierre;
}
